{
  "name": "reitti",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @reitti/web",
    "build": "npm run build --workspace @reitti/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "test:a11y:report": "playwright show-report",
    "test:a11y:setup": "playwright install --with-deps chromium webkit",
    "typecheck": "tsc --build --force",
    "rules:print": "vite-node scripts/print-rules.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
